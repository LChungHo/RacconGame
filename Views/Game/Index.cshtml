@model GamePageViewModel
@using System.Text.Json
@{
    var json = JsonSerializer.Serialize(Model, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}
<main class="arcade" id="game-root">
<header class="masthead"><a class="wordmark" href="@Url.Content("~/")"><span class="coin-mark">P</span> 작은 오락실 <span class="edition">ARCADE / 001</span></a><span class="online"><i></i> SINGLE PLAYER</span></header>
<div class="heading"><div><p class="eyebrow">1982 INSPIRED · A LITTLE ARCADE CLASSIC</p><h1>너구리<span>PONPOKO</span></h1><p class="subtitle">사다리를 오르고, 폴짝 뛰고, 먹거리를 모두 모아보세요.</p></div><div class="edition-seal">ONE MORE<br/><strong>TRY!</strong><span>작은 도전, 큰 재미</span></div></div>
<section class="cabinet" aria-label="너구리 게임">
<header class="arcade-hud" aria-label="게임 현황">
<div class="arcade-score-row"><div class="player-score"><span>1UP</span><div class="pixel-score"><strong id="score" class="sr-only">0</strong><canvas id="score-display" width="180" height="28" aria-hidden="true"></canvas></div></div><div class="record-score"><span>TOP SCORE</span><div class="pixel-score"><strong id="top-score" class="sr-only">0</strong><canvas id="top-score-display" width="180" height="28" aria-hidden="true"></canvas></div></div></div>
<div class="stage-clock-row"><strong id="stage" aria-label="현재 스테이지">1</strong><div id="time" class="time-gauge" role="progressbar" aria-label="남은 시간" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100"><span id="time-fill"></span></div></div>
<ol id="food-strip" aria-label="진행한 스테이지"></ol>
</header>
<div class="screen-wrap"><canvas id="game-canvas" width="864" height="672" tabindex="0" aria-label="너구리 게임 화면. 방향키 이동, 스페이스 점프"></canvas>
<div class="screen-overlay" id="screen-overlay"><span class="overlay-kicker">READY TO PLAY?</span><h2 id="overlay-title">먹거리 탐험을 시작해요</h2><p id="overlay-copy">모든 먹거리를 모으면 다음 스테이지!</p><span class="start-hint">PRESS ENTER OR START</span></div>
<section id="clear-celebration" class="clear-celebration" aria-labelledby="clear-title" hidden>
<p class="celebration-kicker">PONPOKO · STAGE CLEAR</p><h2 id="clear-title">스테이지 클리어!</h2>
<dl class="clear-scores"><div><dt>획득 점수</dt><dd id="clear-stage-score">0</dd></div><div><dt>시간 보너스</dt><dd id="clear-bonus">0</dd></div><div class="clear-grand-total"><dt>TOTAL SCORE</dt><dd id="clear-total">0</dd></div></dl>
<div id="clear-dancers" aria-label="다섯 마리 너구리가 함께 춤을 춥니다"></div>
<p class="clear-next" id="clear-next">잠시 후 다음 스테이지로!</p></section>
<section id="result-panel" class="result-panel" aria-labelledby="result-title" hidden>
<p class="celebration-kicker">SHARED HIGH SCORES</p><h2 id="result-title">GAME OVER</h2>
<p class="final-score-label">나의 최종 점수 <strong id="final-score">0점</strong></p>
<form id="score-form">@Html.AntiForgeryToken()<label for="player-name">순위에 남길 이름</label><div class="name-entry"><input id="player-name" name="playerName" maxlength="12" required autocomplete="nickname" placeholder="이름 (1~12자)"/><button id="save-score" class="button primary" type="submit">기록 저장</button></div></form>
<p id="result-receipt" class="result-receipt" role="status"></p><p id="result-message" role="status"></p>
<div class="leaderboard"><table><caption>전체 플레이어 TOP 10</caption><thead><tr><th scope="col">순위</th><th scope="col">이름</th><th scope="col">점수</th></tr></thead><tbody id="leaderboard-body"></tbody></table></div>
<p class="result-tip">다시 시작 버튼으로 새 게임을 시작하세요.</p></section>
<div id="game-error" role="alert" hidden></div></div>
<div class="cabinet-bottom"><span id="game-status" role="status" data-phase="ready">시작을 눌러주세요</span><span class="arcade-meta"><span id="stage-label">1 / 20 · 당근</span></span></div>
<div class="life-panel" id="life-panel" role="img" aria-label="남은 기회 3번"><span id="life-status">남은 기회</span><ol id="life-strip"></ol><strong id="lives" class="sr-only">3</strong></div>
</section>
<div class="controls" aria-label="게임 조작">
<div class="primary-controls"><button id="start" class="button primary" aria-label="시작">시작 <span aria-hidden="true">↵</span></button><button id="pause" class="button" disabled>일시정지 <span>P</span></button><button id="restart" class="button">다시 시작 <span>↻</span></button></div>
<button id="mute" class="sound-button" aria-pressed="false" aria-label="음소거">♪ 소리 켜짐</button>
</div>
<section class="instructions" aria-label="플레이 방법"><div><span class="instruction-index">01</span><div><h3>가볍게 움직이세요</h3><p>방향키 <kbd>←</kbd> <kbd>→</kbd> 이동 · <kbd>↑</kbd> <kbd>↓</kbd> 사다리</p></div></div><div><span class="instruction-index">02</span><div><h3>위험은 폴짝 넘어요</h3><p><kbd class="wide-key">SPACE</kbd> 점프 · 적은 사다리로 피하세요!</p></div></div><div><span class="instruction-index">03</span><div><h3>모두 모으면 성공</h3><p>먹은 순서대로 점수 UP · 주머니는 고정 패턴</p></div></div></section>
<footer><span>작은 오락실에서 즐기는 너구리의 모험</span><span>INSPIRED BY PONPOKO · ORIGINAL PIXEL ART</span></footer>
</main>
<script id="game-config" type="application/json">@Html.Raw(json)</script>
